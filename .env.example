# Copy to .env.local and fill in. Never commit real keys.

# Claude API (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Channel3 product search (sign up: https://trychannel3.com/sign-up/developer)
CHANNEL3_API_KEY=

# PayPal Developer, Sandbox app (https://developer.paypal.com/dashboard/applications/sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Model for the gift agent
ANTHROPIC_MODEL=claude-haiku-5-5

# Group gifts: shared storage (https://console.upstash.com, Redis -> REST API)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sandbox demo: shows "let the others join" on group gifts (simulated friends). Never in production.
DEMO_MODE=true
